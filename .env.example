LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=3002

# AGENT_SESSION_CAP=5   # max sessions per user; LRU-evicted beyond this

# MCP — tools are sourced from the companion mcp-server-template.
MCP_SERVER_URL=http://localhost:3001/mcp
# MCP_AUTH_TOKEN=       # matches mcp-server-template's DEV_TOKEN in dev
MCP_VERIFY_SSL=true

#bedrock/openai
AGENT_MODEL_PROVIDER=openai

# You need to set options below only if you use OPENAI or CLAUDE
###########################################################################
# OPENAI / CLAUDE
###########################################################################
# OpenAI provider — only read when AGENT_MODEL_PROVIDER=openai. Nothing
# extra to install — both providers ship as core dependencies. Just set
# OPENAI_API_KEY (unprefixed to match the SDK's own standard var name, same
# convention as AWS_REGION/AWS_PROFILE below) and you're done.
# AGENT_OPENAI_MODEL_ID defaults to a small/cheap model on purpose — set it
# explicitly for production use.

# OPENAI_API_KEY=
# AGENT_OPENAI_MODEL_ID=gpt-4o-mini
# AGENT_OPENAI_BASE_URL=        # OpenAI-compatible endpoints (Azure/local/proxy)
# AGENT_OPENAI_TIMEOUT=60
# AGENT_OPENAI_MAX_RETRIES=2



# You need to set all options below only if you use AWS Bedrock
###########################################################################
# BEDROCK / AGENTCORE — set AGENT_MODEL_PROVIDER=bedrock above to use these
###########################################################################

# Recommended for production: AgentCore memory, Bedrock Guardrails, Bedrock
# Knowledge Base, and CloudWatch/ADOT observability all require Bedrock
# regardless of which provider you pick for the model call itself — but
# it's opt-in, not the default, since it needs real AWS setup below.

# AWS_REGION — required, no default region on purpose. Required when
# AGENT_MODEL_PROVIDER=bedrock, or when AGENT_KB_ID /
# AGENTCORE_CODE_INTERPRETER_ID is set below (those two stay Bedrock-only
# regardless of provider). Not required for AGENT_MODEL_PROVIDER=openai
# on its own.

# AWS_REGION=us-east-1
# AWS_PROFILE=
# OR
# BEDROCK_API_KEY=

# Explicit AWS credentials — an alternative to AWS_PROFILE (e.g. CI runners,
# containers, or temporary STS credentials with no local profile configured).
# boto3 picks these up automatically once set; nothing in this template reads
# them directly. Only needed if AWS_PROFILE/an attached IAM role isn't
# available.
#
# IMPORTANT: BEDROCK_API_KEY (bearer token) only authenticates plain Bedrock
# model calls (ConverseStream) — it does NOT work for AgentCore APIs
# (memory, checkpointing, code interpreter), which require standard AWS
# SigV4 credentials. If you're using AGENTCORE_MEMORY_ID or
# AGENTCORE_CODE_INTERPRETER_ID below, you MUST use AWS_PROFILE or the
# explicit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN triple
# here — BEDROCK_API_KEY alone will authenticate the model call and then
# fail on the first AgentCore call.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AGENT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bare model IDs like the one above only work as-is in regions with direct
# on-demand throughput for that model (notably us-east-1/us-west-2). Most
# other regions (eu-central-1, ap-*, ...) require the CROSS-REGION INFERENCE

# Prompt caching (Bedrock cachePoint) — off by default.

# AGENT_PROMPT_CACHE_ENABLED=true
# AGENT_PROMPT_CACHE_SCOPE=full     # full | prefix_only
# AGENT_PROMPT_CACHE_TTL=           # e.g. "1h" (default 5m when unset)

# Bedrock input guardrail — unset (default) means no guardrail at all, not
# an error. Fails open on any API error either way. Only consulted when
# AGENT_MODEL_PROVIDER=bedrock; see AGENT_GUARDRAIL_BLOCKLIST below for the
# non-Bedrock fallback.

# AGENT_GUARDRAIL_ID=
# AGENT_GUARDRAIL_VERSION=DRAFT

# Non-Bedrock guardrail fallback — a small built-in keyword blocklist (plus
# an opportunistic LangChain-ecosystem moderation chain if langchain-classic
# happens to be installed) used when AGENT_MODEL_PROVIDER != bedrock. Extra
# comma-separated terms on top of the built-in list; fails open like the
# Bedrock guardrail above.

# AGENT_GUARDRAIL_BLOCKLIST=

# AgentCore-backed persistence — unset (default) means plain in-memory
# persistence, lost on restart; the agent runs a complete turn either way.
#
# These are AWS resources you provision, not something this template creates
# for you. Roughly:
#   1. Create a memory resource with a semantic-memory strategy enabled —
#      via the AWS Console (Bedrock > AgentCore > Memory) or
#      `aws bedrock-agentcore-control create-memory` (exact CLI flags change
#      across AWS SDK versions; the console is the more stable path for a
#      first-time setup). Note the returned memory id.
#   2. The semantic strategy id is returned alongside the memory resource
#      (or via `aws bedrock-agentcore-control get-memory` / the console) once
#      the strategy has finished being created — it looks like
#      "semantic_builtin_<random>", not something you choose.
#   3. Paste both below.

# AGENTCORE_MEMORY_ID=
# AGENTCORE_SEMANTIC_STRATEGY_ID=
# AGENT_MEMORY_TOP_K=5

# Separate opt-in even when memory_id is set — a known langgraph-checkpoint-aws
# compatibility issue can break HITL resume. The memory STORE (long-term,
# cross-session facts) is unaffected and always uses AgentCore once
# AGENTCORE_MEMORY_ID is set; this only gates checkpointing (conversation/
# interrupt state).

# AGENT_AGENTCORE_CHECKPOINTER_ENABLED=false

# Bedrock Knowledge Base — read-only retrieval bound as a kb_retrieve tool.
# Unset (default) means KB is disabled entirely; no separate enabled flag,
# same pattern as AGENTCORE_MEMORY_ID above.

# AGENT_KB_ID=
# AGENT_KB_REGION=          # falls back to AWS_REGION when unset
# AGENT_KB_CHUNKS=3         # numberOfResults per retrieve call
# AGENT_KB_MAX_CHARS=2000   # char cap on the tool's formatted response

# ADOT (OpenTelemetry) tracing + metrics, gated by AGENT_OBSERVABILITY_ENABLED
# below. OTEL_* names are the standard OpenTelemetry env vars, not this
# project's own prefix.

# OTEL_SERVICE_NAME=ai-agent-template
# OTEL_RESOURCE_ATTRIBUTES=          # e.g. "service.version=1.0,env=prod"

# CloudWatch Logs — ships every log record when set. Gated independently of
# AGENT_OBSERVABILITY_ENABLED (a deployment may want one without the other).
# Requires: pip install '.[cloudwatch]'

# CLOUDWATCH_LOG_GROUP=
# CLOUDWATCH_LOG_STREAM=             # default: <hostname>/<YYYY-MM-DD>

# Feature flags — every optional module defaults off. The agent runs a
# complete turn with all of these unset; flip one on only once its module
# is configured (each has its own env vars, added when that module lands).

# AGENT_OBSERVABILITY_ENABLED=false
# AGENT_DOCUMENT_INGESTION_ENABLED=false
# AGENT_ORCHESTRATION_ENABLED=false

# Orchestration tool (run_orchestration) — local, in-process RestrictedPython
# sandbox for calling already-bound tools in a dependent chain/branch/reshape/
# loop. No external AWS resource, so AGENT_ORCHESTRATION_ENABLED above is the
# sole gate. Mutation tools are NOT reachable from inside the sandbox (see
# agent/orchestration/tool_bridge.py) — only read-only (get_*) tools are.

# AGENT_ORCHESTRATION_TIMEOUT_SECONDS=15      # wall-clock cap per run
# AGENT_ORCHESTRATION_MAX_RESULT_CHARS=4000   # truncation cap on stdout/result
# AGENT_ORCHESTRATION_MAX_CALLS=256           # bound-tool call budget per run
# AGENT_ORCHESTRATION_CALL_TIMEOUT_SECONDS=15 # per bound-tool-call timeout

# Code execution tool (run_python) — remote AgentCore Code Interpreter sandbox
# for data analysis/statistics/Plotly charts (no access to this project's own
# tools — see run_orchestration above for that). Unset (default) means code
# execution is entirely disabled; AGENTCORE_CODE_INTERPRETER_ID presence is
# the sole gate, same pattern as AGENTCORE_MEMORY_ID/AGENT_KB_ID — no separate
# enabled flag. Same AgentCore auth requirement as memory above: this is an
# AgentCore API, so AWS_PROFILE or explicit AWS_ACCESS_KEY_ID/SECRET/SESSION
# credentials are required — BEDROCK_API_KEY alone does NOT work here.
#
# Also a provisioned AWS resource, not created by this template — via the AWS
# Console (Bedrock > AgentCore > Code Interpreter, "Create custom") or
# `aws bedrock-agentcore-control create-code-interpreter --name <your-name>`.
# Paste the returned codeInterpreterId (or codeInterpreterIdentifier) below.

# AGENTCORE_CODE_INTERPRETER_ID=
# AGENT_CODE_EXECUTION_REGION=                        # falls back to AWS_REGION
# AGENT_CODE_EXECUTION_TIMEOUT_SECONDS=90              # wall-clock cap per run_python call
# AGENT_CODE_EXECUTION_SANDBOX_IDLE_TIMEOUT_SECONDS=300 # AgentCore session idle timeout
